<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top row: thumbnail + name/fuel + stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Vehicle thumbnail -->
        <ImageView
            android:id="@+id/iv_vehicle_thumb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Araç"
            android:background="@drawable/widget_thumb_bg"
            android:scaleType="centerCrop" />

        <!-- Name + fuel type -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_vehicle_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Araç Seçilmedi"
                android:textColor="#1C1917"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_fuel_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="#78716C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Stats column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cost_per_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="—"
                android:textColor="#16A34A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_liters_per100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="end"
                android:text="—"
                android:textColor="#78716C"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_total_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="end"
                android:text="—"
                android:textColor="#A8A29E"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#1A000000" />

    <!-- Add Fuel Button -->
    <TextView
        android:id="@+id/btn_add_fuel"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:text="+ Yakıt Ekle"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
