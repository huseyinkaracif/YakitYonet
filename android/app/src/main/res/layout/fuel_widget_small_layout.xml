<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="10dp">

    <!-- Vehicle thumbnail -->
    <ImageView
        android:id="@+id/iv_vehicle_thumb_small"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:contentDescription="Araç"
        android:background="@drawable/widget_thumb_bg"
        android:scaleType="centerCrop" />

    <!-- Vehicle name -->
    <TextView
        android:id="@+id/tv_vehicle_name_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/iv_vehicle_thumb_small"
        android:layout_marginStart="9dp"
        android:layout_alignTop="@id/iv_vehicle_thumb_small"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Araç Seçilmedi"
        android:textColor="#1C1917"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Fuel type -->
    <TextView
        android:id="@+id/tv_fuel_type_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/iv_vehicle_thumb_small"
        android:layout_below="@id/tv_vehicle_name_small"
        android:layout_marginStart="9dp"
        android:layout_marginTop="1dp"
        android:text=""
        android:textColor="#78716C"
        android:textSize="10sp" />

    <!-- Add Fuel Button -->
    <TextView
        android:id="@+id/btn_add_fuel_small"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="+ Yakıt Ekle"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Stats row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/iv_vehicle_thumb_small"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- ₺/km -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cost_per_km_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#16A34A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₺/km"
                android:textColor="#A8A29E"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1A000000" />

        <!-- L/100 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_liters_per100_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#78716C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L/100"
                android:textColor="#A8A29E"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1A000000" />

        <!-- Total KM -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_total_km_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#78716C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km"
                android:textColor="#A8A29E"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
